    "test:e2e:staging:mobile": "PLAYWRIGHT_REMOTE=1 PLAYWRIGHT_BASE_URL=https://roster-generator-oibn.onrender.com PLAYWRIGHT_API_BASE_URL=https://roster-generator-oibn.onrender.com playwright test --project=iphone --project=android"
