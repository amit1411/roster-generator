# Public ports exposed on the VM
PROXY_HTTP_PORT=80
POSTGRES_HOST_PORT=5432
BACKEND_WORKERS=2

# Postgres container settings
POSTGRES_DB=badminton_roster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend secrets/config
ADMIN_RECOVERY_TOKEN=change-me
GOOGLE_CLIENT_ID=

# Cache settings
# Memory is the easiest default when backend and DB are on the same VM.
# If you later add Redis, switch CACHE_BACKEND=redis and provide REDIS_URL.
CACHE_ENABLED=true
CACHE_BACKEND=memory
REDIS_URL=
