GOOGLE_CLIENT_ID=your-google-client-id
ADMIN_RECOVERY_TOKEN=your-organizer-token
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/badminton_roster

# Cache setup
# Use "redis" in Render by pointing REDIS_URL at your Render Redis instance.
# Use "memory" locally if you do not want to run Redis on your machine.
CACHE_ENABLED=true
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Optional TTL overrides in seconds
CACHE_TTL_GENERATE=3600
CACHE_TTL_SESSION_DETAIL=15
CACHE_TTL_SESSIONS=20
CACHE_TTL_PLAYERS=300
CACHE_TTL_HISTORY=60
CACHE_TTL_PLAYER_STATS=60
